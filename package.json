{
  "name": "ai-web-platform",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "core:auth:build": "tsc -p core/auth/tsconfig.json",
    "build": "tsc",
    "dev": "tsx src/generator/generate.ts",
    "ai:generate": "tsx src/ai/generate-ai-website.ts",
    "template:build": "vite build --config templates/react/vite.config.ts",
    "local-store:client:dev": "vite --config projects/local-store/client/vite.config.ts",
    "local-store:server:dev": "npm run core:auth:build && tsx watch projects/local-store/server/src/index.ts",
    "local-store:client:build": "vite build --config projects/local-store/client/vite.config.ts",
    "local-store:server:build": "npm run core:auth:build && tsc -p projects/local-store/server/tsconfig.json",
    "local-store:typecheck": "npm run core:auth:build && tsc --noEmit -p projects/local-store/client/tsconfig.json && tsc --noEmit -p projects/local-store/server/tsconfig.json",
    "local-store:build": "npm run local-store:client:build && npm run local-store:server:build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asthapandey06/ai-web-platform.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/asthapandey06/ai-web-platform/issues"
  },
  "homepage": "https://github.com/asthapandey06/ai-web-platform#readme",
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/cookie-parser": "^1.4.9",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^7.0.0"
  },
  "dependencies": {
    "@websiteos/auth-crypto": "file:core/auth",
    "dotenv": "^18.0.4",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "pg": "^8.23.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "yaml": "^2.9.1"
  }
}
